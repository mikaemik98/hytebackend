# Test HTTP requests
### use with: REST Client extension
@apiurl = http://localhost:3000/api

### GET all items
GET {{apiurl}}/items

### GET item with id 1
GET {{apiurl}}/items/1


### Add new item
POST {{apiurl}}/items
Content-Type: application/json

{"name": "Mandariini", "weight": 86}

### Delete item with id 2
DELETE {{apiurl}}/items/2

### Update item with id 1
PUT {{apiurl}}/items/1
Content-Type: application/json

{"name": "updated Omena"}

### Get all users
GET http://localhost:3000/users

### Create a new user
POST http://localhost:3000/users
Content-Type: application/json

 {
    "username": "John Smith",
    "password": "password4",
    "email": "johnsmith@example.com"
    }

### Get user by id
GET http://localhost:3000/users/6
Content-Type: application/json

### Update user by id
PUT http://localhost:3000/users/2
Content-Type: application/json

 {
   "username": "updated",
    "email": "updated@example.com"
 }

### Login succes
POST http://localhost:3000/login
Content-Type: application/json

 {
    "username": "johndoe",
    "password": "password1"
 }

### Login fail
POST http://localhost:3000/login
Content-Type: application/json

 {
    "username": "johndoe",
    "password": "väärä"
 }

### Delete user by id
DELETE http://localhost:3000/users/3
Content-Type: application/json